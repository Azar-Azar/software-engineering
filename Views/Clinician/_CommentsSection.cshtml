@model int // DataID
@using software_engineering.Models
@inject software_engineering.Data.AppDBContext db
@{
    var dataId = Model;
    var comments = db.Comments
        .Where(c => c.DataID == dataId && c.ParentCommentID == null)
        .OrderByDescending(c => c.CreatedAt)
        .ToList();
    Func<int, List<Comment>> getReplies = parentId => db.Comments
        .Where(c => c.ParentCommentID == parentId)
        .OrderBy(c => c.CreatedAt)
        .ToList();
    var users = db.User.ToDictionary(u => u.ID, u => u.Fullname);
}

<div id="comments-list">
    @if (!comments.Any())
    {
        <div class="alert alert-info">No comments yet. Be the first to comment!</div>
    }
    else
    {
        <ul class="list-group mb-4">
            @foreach (var comment in comments)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@(users.ContainsKey(comment.UserID) ? users[comment.UserID] : "Unknown")</strong>
                            <span class="text-muted small">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                    <div class="mt-2">@comment.Content</div>
                    <button class="btn btn-link btn-sm text-primary mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#replyForm-@comment.CommentID">Reply</button>
                    <!-- Replies -->
                    @{
                        var replies = getReplies(comment.CommentID);
                    }
                    @if (replies.Any())
                    {
                        <ul class="list-group mt-2 ms-4">
                            @foreach (var reply in replies)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@(users.ContainsKey(reply.UserID) ? users[reply.UserID] : "Unknown")</strong>
                                            <span class="text-muted small">@reply.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                        </div>
                                    </div>
                                    <div class="mt-2">@reply.Content</div>
                                </li>
                            }
                        </ul>
                    }
                    <!-- Reply Form (collapsible) -->
                    <div class="collapse mt-2" id="replyForm-@comment.CommentID">
                        <form asp-action="AddComment" method="post">
                            <input type="hidden" name="DataID" value="@dataId" />
                            <input type="hidden" name="ParentCommentID" value="@comment.CommentID" />
                            <div class="mb-2">
                                <textarea name="Content" class="form-control" rows="2" placeholder="Write a reply..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary">Reply</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</div>

<!-- New Comment Form -->
<div class="card mt-3">
    <div class="card-body">
        <form asp-action="AddComment" method="post">
            <input type="hidden" name="DataID" value="@dataId" />
            <div class="mb-2">
                <textarea name="Content" class="form-control" rows="3" placeholder="Add a comment..."></textarea>
            </div>
            <button type="submit" class="btn btn-success">Post Comment</button>
        </form>
    </div>
</div>