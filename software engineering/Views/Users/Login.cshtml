<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login Page</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #ffffff;
      color: #2d3e2d;
    }

    .container {
      display: flex;
      height: 100vh;
    }

    .left-section {
      flex: 1.2;
      padding: 40px 80px;
    }

    .logo {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: #a2e19a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: bold;
      color: #2d3e2d;
      margin-bottom: 60px;
    }

    h1 {
      font-size: 32px;
      margin-bottom: 10px;
      font-weight: 700;
    }

    p.subtitle {
      font-size: 14px;
      margin-bottom: 30px;
    }

    label {
      font-size: 14px;
      display: block;
      margin-bottom: 6px;
      font-weight: bold;
    }

    .input-group {
      position: relative;
      margin-bottom: 22px;
    }

    .input-group input {
      width: 50%;
      padding: 12px 40px 12px 40px;
      border-radius: 8px;
      border: 1px solid #b5b5b5;
      font-size: 14px;
    }

    .input-group .icon {
      position: absolute;
      top: 40%;
      left: 12px;
      transform: translateY(-50%);
      font-size: 16px;
      color: #4c8f4c;
    }

    .input-group .toggle {
      position: absolute;
      top: 60%;
      right: 12px;
      transform: translateY(-50%);
      cursor: pointer;
      font-size: 16px;
      color: #4c8f4c;
    }

    .forgot:hover {
      text-decoration: underline;
    }

    .btn {
      width: 397px;
      padding: 12px;
      background: #365f2b;
      border: none;
      border-radius: 8px;
      color: #fff;
      font-size: 16px;
      cursor: pointer;
    }

    .btn:hover {
      background: #2e5225;
    }

    .right-section {
      flex: 0.4;
      background: #cbbebe;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="left-section">
      <div class="logo">App<br>Logo</div>
      
      <h1>Welcome Back !</h1>
      <p class="subtitle">Sign in to access your account</p>

      <label for="email">Email</label>
      <div class="input-group">
        <span class="icon">✉️</span>
        <input type="email" id="email" placeholder="Enter your email" />
      </div>

      <label for="password">Password</label>
      <div class="input-group">
        <span class="icon">🔒</span>
        <input type="password" id="password" placeholder="Enter your password" />
        
      </div>

      
      <button class="btn">Sign in</button>
    </div>

    <div class="right-section"></div>
  </div>
</body>
</html>
